# Agnovat MCP Server Environment Configuration

# Storage Configuration
# Options: 'json' (default) or 'convex'
STORAGE_TYPE=json

# JSON Storage Configuration (used when STORAGE_TYPE=json)
DATA_DIR=./data

# Convex Storage Configuration (used when STORAGE_TYPE=convex)
# Get your Convex URL from: https://dashboard.convex.dev/
# CONVEX_URL=https://your-project.convex.cloud

# Optional: Convex Authentication Token
# CONVEX_AUTH_TOKEN=your-auth-token

# Logging Configuration (optional)
# LOG_LEVEL=info

# Clerk Authentication Configuration (for Convex integration)
# Get these values from: https://dashboard.clerk.com/
# CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Server Configuration (optional)
# NODE_ENV=production
